DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# Optional paths. Default to jwt_private.pem and jwt_public.pem in the working directory.
# JWT_PRIVATE_KEY_FILE=jwt_private.pem
# JWT_PUBLIC_KEY_FILE=jwt_public.pem
# Absolute JWK Set URL embedded in tokens. Empty uses the request host.
# JWT_JWKS_URL=https://auth.example.com/api/keys/
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=5
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1
# DRF rates. Requests without an access token use API_THROTTLE_ANON.
API_THROTTLE_ANON=5/hour
API_THROTTLE_USER=500/hour
# POST /api/users/ only. Anonymous and authenticated callers are separate.
API_THROTTLE_USER_CREATE_ANON=5/hour
API_THROTTLE_USER_CREATE_USER=5/hour
# Browser SPAs on these origins may call /api/* (login, refresh, users).
# GET /api/keys/ always allows any origin so jwt.io can follow jku.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
